# PostgreSQL (local development defaults only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=meetai_db
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/meetai_db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT foundation (use a long random value outside local development)
JWT_SECRET_KEY=change-me-in-local-development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI / audio processing
OPENAI_API_KEY=
AUDIO_UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# Runtime
ENVIRONMENT=development

# Service URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

